# Review template ONLY; not installed, enabled, or deployed by CI.
# Copy only after independent host/runtime review. This unit deliberately
# executes OFFLINE tests, not a collector job, and has no [Install] section.
# The example WorkingDirectory is a placeholder, not an existing deployment.
[Unit]
Description=Hyperliquid read-only collector OFFLINE sandbox review
Documentation=https://github.com/mikeokeeffe-droid/crypto-yall/pull/41
ConditionPathExists=/opt/crypto-yall/collector_review/testnet_info_https.py

[Service]
Type=oneshot
WorkingDirectory=/opt/crypto-yall
ExecStart=/usr/bin/python3 -B -m collector_review.host_isolation_probe
ExecStart=/usr/bin/python3 -B -m unittest collector_review.test_testnet_info_https collector_review.test_offline_capture_audit collector_review.test_runtime_identity_review -v
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# No EnvironmentFile, LoadCredential, network access, writable secret store,
# ExecStartPre privilege escalation, or trading signing key is permitted.
# Even if this example eventually runs, it would not prove source provenance.
